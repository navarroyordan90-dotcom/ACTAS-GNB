    <!-- MODAL DE CONFIRMACIÓN DE ACTA GENERADA -->
    <div id="modal-confirm" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden no-print">
        <div class="bg-gnb-card border-2 border-gnb-gold rounded-2xl max-w-lg w-full p-6 shadow-2xl space-y-6 text-center transform transition-all">
            <div class="w-16 h-16 rounded-full bg-gnb-gold/20 border-2 border-gnb-gold flex items-center justify-center text-gnb-gold mx-auto animate-bounce">
                <i class="fa-solid fa-circle-check text-3xl"></i>
            </div>

            <div>
                <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest">¡Acta Asignada Exitosamente!</span>
                <h3 class="text-xl font-extrabold text-white mt-1">NÚMERO DE ACTA OFICIAL:</h3>
                <div class="mt-3 p-4 bg-black/50 rounded-xl border border-gnb-gold/50">
                    <p id="modal-num-acta" class="text-lg sm:text-xl font-black text-gnb-gold tracking-wider select-all">
                        CZGNB13-DI-...
                    </p>
                </div>
            </div>

            <p class="text-xs text-slate-300">
                El número de acta fue registrado de manera única en la secuencia del Comando de Zona N° 13. Puede imprimir la constancia oficial inmediatamente.
            </p>

            <div class="flex items-center justify-center space-x-3 pt-2">
                <button onclick="closeModalAndPrintCurrent()" class="px-5 py-2.5 bg-gnb-gold text-gnb-dark font-bold rounded-lg text-xs hover:bg-gnb-goldhover transition-all flex items-center space-x-2">
                    <i class="fa-solid fa-print"></i>
                    <span>Imprimir Constancia</span>
                </button>
                <button onclick="closeModal()" class="px-5 py-2.5 bg-gnb-light/50 hover:bg-gnb-light text-white font-bold rounded-lg text-xs transition-all">
                    <span>Cerrar</span>
                </button>
            </div>
        </div>
    </div>

    <!-- AREA DE IMPRESIÓN EXCLUSIVA / CONSTANCIA OFICIAL (OCULTA EN PANTALLA) -->
    <div id="printArea" class="hidden">
        <div style="font-family: Arial, sans-serif; max-width: 800px; margin: 0 auto; color: #000; padding: 20px;">
            <!-- ENCABEZADO OFICIAL -->
            <div style="text-align: center; border-bottom: 2px solid #000; padding-bottom: 12px; margin-bottom: 20px;">
                <p style="font-size: 11px; font-weight: bold; margin: 0; uppercase">REPÚBLICA BOLIVARIANA DE VENEZUELA</p>
                <p style="font-size: 11px; font-weight: bold; margin: 0; uppercase">MINISTERIO DEL PODER POPULAR PARA LA DEFENSA</p>
                <p style="font-size: 11px; font-weight: bold; margin: 0; uppercase">FUERZA ARMADA NACIONAL BOLIVARIANA</p>
                <p style="font-size: 11px; font-weight: bold; margin: 0; uppercase">GUARDIA NACIONAL BOLIVARIANA</p>
                <p style="font-size: 11px; font-weight: bold; margin: 0; uppercase">COMANDO DE ZONA N° 13 - ESTADO FALCÓN</p>
                <p style="font-size: 11px; font-weight: bold; margin: 0; uppercase; color: #800020;">DIVISIÓN DE INTELIGENCIA MILITAR</p>
            </div>

            <!-- TITULO Y NUMERO DE ACTA -->
            <div style="text-align: center; margin-bottom: 25px;">
                <h2 style="font-size: 16px; font-weight: bold; text-decoration: underline; margin-bottom: 8px;">CONSTANCIA OFICIAL DE ASIGNACIÓN DE NÚMERO DE ACTA PENAL</h2>
                <div style="display: inline-block; border: 2px solid #000; padding: 8px 16px; background-color: #f8f9fa; font-size: 16px; font-weight: bold; margin-top: 5px;">
                    <span id="print-num-acta">CZGNB13-DI-UNIDAD-SIP-0000-26</span>
                </div>
            </div>

            <!-- DATOS DEL REGISTRO -->
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 30px; font-size: 12px;">
                <tr>
                    <td style="padding: 8px; border: 1px solid #000; font-weight: bold; width: 30%; background-color: #f0f0f0;">UNIDAD SOLICITANTE:</td>
                    <td id="print-unidad" style="padding: 8px; border: 1px solid #000;">-</td>
                </tr>
                <tr>
                    <td style="padding: 8px; border: 1px solid #000; font-weight: bold; background-color: #f0f0f0;">FECHA Y HORA DEL HECHO:</td>
                    <td id="print-fecha" style="padding: 8px; border: 1px solid #000;">-</td>
                </tr>
                <tr>
                    <td style="padding: 8px; border: 1px solid #000; font-weight: bold; background-color: #f0f0f0;">FUNCIONARIOS ACTUANTES:</td>
                    <td id="print-funcionarios" style="padding: 8px; border: 1px solid #000; white-space: pre-wrap;">-</td>
                </tr>
                <tr>
                    <td style="padding: 8px; border: 1px solid #000; font-weight: bold; background-color: #f0f0f0;">CAUSA / PRESUNCIÓN:</td>
                    <td id="print-causa" style="padding: 8px; border: 1px solid #000; white-space: pre-wrap;">-</td>
                </tr>
                <tr>
                    <td style="padding: 8px; border: 1px solid #000; font-weight: bold; background-color: #f0f0f0;">AUXILIAR INTELIGENCIA:</td>
                    <td id="print-auxiliar" style="padding: 8px; border: 1px solid #000;">-</td>
                </tr>
                <tr>
                    <td style="padding: 8px; border: 1px solid #000; font-weight: bold; background-color: #f0f0f0;">OBSERVACIONES:</td>
                    <td id="print-observaciones" style="padding: 8px; border: 1px solid #000;">-</td>
                </tr>
            </table>

            <p style="font-size: 11px; text-align: justify; margin-bottom: 60px;">
                Se certifica que el número correlativo de acta penal antes mencionado ha sido registrado de manera autógrafa y correlativa en el Sistema Centralizado de Inteligencia del Comando de Zona N° 13 Falcón, garantizando la cadena de secuencia legal institucional.
            </p>

            <!-- FIRMAS DIGITALES / INSTITUCIONALES -->
            <div style="display: flex; justify-content: space-between; margin-top: 80px; text-align: center;">
                <div style="width: 45%;">
                    <div style="border-top: 1px solid #000; padding-top: 5px;">
                        <p id="print-firma-auxiliar" style="font-size: 11px; font-weight: bold; margin: 0;">AUXILIAR RECEPTOR</p>
                        <p style="font-size: 10px; margin: 0;">División de Inteligencia CZGNB-13</p>
                    </div>
                </div>

                <div style="width: 45%;">
                    <div style="border-top: 1px solid #000; padding-top: 5px;">
                        <p style="font-size: 11px; font-weight: bold; margin: 0;">JEFE DE LA DIVISIÓN DE INTELIGENCIA MILITAR</p>
                        <p style="font-size: 10px; margin: 0;">Comando de Zona N° 13 Falcón</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TOAST / NOTIFICATION SYSTEM -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
        <div id="toast-content" class="bg-gnb-card border border-gnb-gold px-5 py-3 rounded-xl shadow-2xl flex items-center space-x-3 text-xs font-bold text-slate-100">
            <i id="toast-icon" class="fa-solid fa-info-circle text-gnb-gold text-base"></i>
            <span id="toast-message">Mensaje de notificación</span>
        </div>
    </div>

    <!-- JAVASCRIPT LOGIC FOR UI INTERACTION -->
    <script>
        let currentModalActa = null;

        // Switch Tabs
        function switchTab(tab) {
            const btnSol = document.getElementById('tab-btn-solicitud');
            const btnCent = document.getElementById('tab-btn-central');
            const secSol = document.getElementById('tab-solicitud');
            const secCent = document.getElementById('tab-central');

            if (tab === 'solicitud') {
                secSol.classList.remove('hidden');
                secCent.classList.add('hidden');
                btnSol.className = "flex items-center space-x-2 px-4 py-2.5 rounded-lg text-sm font-bold transition-all bg-gnb-gold text-gnb-dark shadow-md hover:bg-gnb-goldhover";
                btnCent.className = "flex items-center space-x-2 px-4 py-2.5 rounded-lg text-sm font-bold transition-all bg-gnb-card hover:bg-gnb-accent text-slate-200 border border-gnb-light/30";
            } else {
                secSol.classList.add('hidden');
                secCent.classList.remove('hidden');
                btnCent.className = "flex items-center space-x-2 px-4 py-2.5 rounded-lg text-sm font-bold transition-all bg-gnb-gold text-gnb-dark shadow-md hover:bg-gnb-goldhover";
                btnSol.className = "flex items-center space-x-2 px-4 py-2.5 rounded-lg text-sm font-bold transition-all bg-gnb-card hover:bg-gnb-accent text-slate-200 border border-gnb-light/30";
            }
        }

        // Handle Form Submit
        async function handleFormSubmit(e) {
            e.preventDefault();
            const btn = document.getElementById('btn-submit');
            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> <span>ASIGNANDO NÚMERO Y GUARDANDO EN FIREBASE...</span>`;

            const formData = {
                unidad: document.getElementById('sol-unidad').value,
                fecha: document.getElementById('sol-fecha').value,
                funcionarios: document.getElementById('sol-funcionarios').value,
                causa: document.getElementById('sol-causa').value,
                auxiliar: document.getElementById('sol-auxiliar').value,
                observaciones: document.getElementById('sol-observaciones').value
            };

            try {
                const newActa = await window.solicitarNuevaActa(formData);
                if (newActa) {
                    currentModalActa = newActa;
                    document.getElementById('modal-num-acta').innerText = newActa.numActa;
                    document.getElementById('modal-confirm').classList.remove('hidden');
                    document.getElementById('form-solicitud').reset();
                    showNotification("Acta registrada exitosamente en tiempo real.", "success");
                }
            } catch (err) {
                console.error("Error al registrar acta:", err);
                showNotification("Error asignando correlativo. Verifique la conexión.", "error");
            } finally {
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-paper-plane text-lg"></i> <span>SOLICITAR NÚMERO DE ACTA EN TIEMPO REAL</span>`;
            }
        }

        // Render Dashboard Metrics
        window.renderStats = function() {
            const list = window.actasData || [];
            document.getElementById('stat-total').innerText = list.length;

            if (list.length > 0) {
                document.getElementById('stat-last-num').innerText = list[0].numActa || 'N/A';
                document.getElementById('stat-correlativo').innerText = `SIP-${String(list[0].correlativo || 0).padStart(4, '0')}`;
            } else {
                document.getElementById('stat-last-num').innerText = 'Sin registros';
                document.getElementById('stat-correlativo').innerText = 'SIP-0000';
            }

            // Count unique units
            const unitsSet = new Set(list.map(a => a.unidad));
            document.getElementById('stat-units-count').innerText = unitsSet.size;
        };

        // Render Table Data with Filters
        window.renderTable = function() {
            const tbody = document.getElementById('table-body');
            const search = (document.getElementById('filter-search')?.value || '').toLowerCase();
            const filterUnidad = document.getElementById('filter-unidad')?.value || '';
            const fechaDesde = document.getElementById('filter-fecha-desde')?.value || '';
            const fechaHasta = document.getElementById('filter-fecha-hasta')?.value || '';

            let list = window.actasData || [];

            // Apply Search Filter
            if (search) {
                list = list.filter(item => 
                    (item.numActa && item.numActa.toLowerCase().includes(search)) ||
                    (item.unidad && item.unidad.toLowerCase().includes(search)) ||
                    (item.funcionarios && item.funcionarios.toLowerCase().includes(search)) ||
                    (item.causa && item.causa.toLowerCase().includes(search)) ||
                    (item.auxiliar && item.auxiliar.toLowerCase().includes(search))
                );
            }

            // Apply Unit Filter
            if (filterUnidad) {
                list = list.filter(item => item.unidad === filterUnidad);
            }

            // Apply Date Filters
            if (fechaDesde) {
                list = list.filter(item => item.fecha >= fechaDesde);
            }
            if (fechaHasta) {
                list = list.filter(item => item.fecha <= fechaHasta + 'T23:59:59');
            }

            if (list.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="p-8 text-center text-slate-400">
                            <i class="fa-solid fa-folder-open text-2xl mb-2 text-slate-500 block"></i>
                            No se encontraron registros de actas penales.
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = list.map(item => `
                <tr class="hover:bg-gnb-accent/40 transition-colors border-b border-gnb-light/20">
                    <td class="p-4 font-extrabold text-gnb-gold whitespace-nowrap">${item.numActa || 'N/A'}</td>
                    <td class="p-4 font-bold text-slate-200">${item.unidad || '-'}</td>
                    <td class="p-4 text-slate-300 whitespace-nowrap">${item.fecha ? new Date(item.fecha).toLocaleString('es-VE') : '-'}</td>
                    <td class="p-4 max-w-xs truncate text-slate-300" title="${escapeHtml(item.funcionarios)}">${escapeHtml(item.funcionarios)}</td>
                    <td class="p-4 max-w-xs truncate text-slate-300" title="${escapeHtml(item.causa)}">${escapeHtml(item.causa)}</td>
                    <td class="p-4 text-slate-300">${escapeHtml(item.auxiliar || '-')}</td>
                    <td class="p-4 text-center">
                        <button onclick="printActaById('${item.id}')" class="px-3 py-1.5 bg-gnb-gold/20 hover:bg-gnb-gold text-gnb-gold hover:text-gnb-dark border border-gnb-gold/50 rounded-lg font-bold text-xs transition-all flex items-center justify-center space-x-1 mx-auto">
                            <i class="fa-solid fa-print"></i>
                            <span>Imprimir</span>
                        </button>
                    </td>
                </tr>
            `).join('');
        };

        // Escape HTML
        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;")
                      .replace(/</g, "&lt;")
                      .replace(/>/g, "&gt;")
                      .replace(/"/g, "&quot;")
                      .replace(/'/g, "&#039;");
        }

        // Close Modal
        function closeModal() {
            document.getElementById('modal-confirm').classList.add('hidden');
        }

        // Close Modal and Print
        function closeModalAndPrintCurrent() {
            closeModal();
            if (currentModalActa) {
                fillAndPrint(currentModalActa);
            }
        }

        // Print Acta by ID from Table
        function printActaById(id) {
            const acta = (window.actasData || []).find(a => a.id === id);
            if (acta) {
                fillAndPrint(acta);
            } else {
                showNotification("No se encontró la información del acta.", "error");
            }
        }

        // Populate Print Template and Launch Browser Print Dialog
        function fillAndPrint(acta) {
            document.getElementById('print-num-acta').innerText = acta.numActa || 'N/A';
            document.getElementById('print-unidad').innerText = acta.unidad || 'N/A';
            document.getElementById('print-fecha').innerText = acta.fecha ? new Date(acta.fecha).toLocaleString('es-VE') : 'N/A';
            document.getElementById('print-funcionarios').innerText = acta.funcionarios || 'N/A';
            document.getElementById('print-causa').innerText = acta.causa || 'N/A';
            document.getElementById('print-auxiliar').innerText = acta.auxiliar || 'N/A';
            document.getElementById('print-observaciones').innerText = acta.observaciones || 'Ninguna.';
            document.getElementById('print-firma-auxiliar').innerText = (acta.auxiliar || 'AUXILIAR RECEPTOR').toUpperCase();

            const printArea = document.getElementById('printArea');
            printArea.classList.remove('hidden');
            window.print();
            printArea.classList.add('hidden');
        }

        // Export All Actas to CSV
        function exportToCSV() {
            const list = window.actasData || [];
            if (list.length === 0) {
                showNotification("No hay datos para exportar.", "error");
                return;
            }

            const headers = ["Numero de Acta", "Unidad Tactica", "Fecha Procedimiento", "Funcionarios Actuantes", "Causa / Delito", "Auxiliar Inteligencia", "Observaciones"];
            const rows = list.map(a => [
                `"${a.numActa || ''}"`,
                `"${a.unidad || ''}"`,
                `"${a.fecha || ''}"`,
                `"${(a.funcionarios || '').replace(/"/g, '""')}"`,
                `"${(a.causa || '').replace(/"/g, '""')}"`,
                `"${a.auxiliar || ''}"`,
                `"${(a.observaciones || '').replace(/"/g, '""')}"`
            ]);

            const csvContent = "\uFEFF" + [headers.join(","), ...rows.map(r => r.join(","))].join("\n");
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.setAttribute("href", url);
            link.setAttribute("download", `Actas_Penales_CZGNB13_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showNotification("Respaldo exportado exitosamente en CSV.", "success");
        }

        // Show Custom Toast Notification
        function showNotification(msg, type = "info") {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toast-message');
            const toastIcon = document.getElementById('toast-icon');

            toastMessage.innerText = msg;
            if (type === "success") {
                toastIcon.className = "fa-solid fa-circle-check text-emerald-400 text-base";
            } else if (type === "error") {
                toastIcon.className = "fa-solid fa-circle-exclamation text-red-400 text-base";
            } else {
                toastIcon.className = "fa-solid fa-info-circle text-gnb-gold text-base";
            }

            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 4000);
        }

        window.showNotification = showNotification;
    </script>
</body>
