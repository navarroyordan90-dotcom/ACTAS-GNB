    <!-- Firebase App & Firestore Scripts -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, getDoc, setDoc, runTransaction, collection, query, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Firebase Configuration & Initialization
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'czgnb13-actas-default';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {
            apiKey: "demo-api-key",
            authDomain: "demo-project.firebaseapp.com",
            projectId: "demo-project",
            storageBucket: "demo-project.appspot.com",
            messagingSenderId: "123456789",
            appId: "1:123456789:web:123456"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);

        // App Global State
        window.db = db;
        window.auth = auth;
        window.appId = appId;
        window.actasData = [];
        window.currentUser = null;

        // Tactical Units List
        window.UNIDADES_TACTICAS = [
            'D-131-1CIA', 'D-131-2CIA', 'D-131-3CIA',
            'D-132-1CIA', 'D-132-2CIA', 'D-132-3CIA', 'D-132-4CIA',
            'D-133-1CIA', 'D-133-2CIA', 'D-133-3CIA',
            'D-134-1CIA', 'D-134-2CIA', 'D-134-3CIA',
            'DESUR-1CIA', 'DESUR-2CIA',
            'DCR-13-1-1CIA', 'DCR-13-1-2CIA',
            'DCR-13-2-1CIA', 'DCR-13-2-2CIA'
        ];

        // Authenticate User & Setup Realtime Listeners
        async function initAuthAndData() {
            try {
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }
            } catch (err) {
                console.warn("Auth initialization fallback:", err);
                try {
                    await signInAnonymously(auth);
                } catch(e) {
                    console.error("Anonymous auth failed:", e);
                }
            }

            onAuthStateChanged(auth, (user) => {
                if (user) {
                    window.currentUser = user;
                    document.getElementById('status-indicator').classList.remove('bg-red-500');
                    document.getElementById('status-indicator').classList.add('bg-emerald-500');
                    document.getElementById('status-text').innerText = 'En Línea - Nube Firebase Sincronizada';
                    subscribeToActas();
                } else {
                    document.getElementById('status-indicator').classList.remove('bg-emerald-500');
                    document.getElementById('status-indicator').classList.add('bg-red-500');
                    document.getElementById('status-text').innerText = 'Sin Conexión';
                }
            });
        }

        // Subscribe to Actas collection in Realtime
        function subscribeToActas() {
            const publicActasCol = collection(db, 'artifacts', appId, 'public', 'data', 'actas_penales');
            const q = query(publicActasCol);

            onSnapshot(q, (snapshot) => {
                const list = [];
                snapshot.forEach((docSnap) => {
                    list.push({ id: docSnap.id, ...docSnap.data() });
                });

                // Sort by correlativo descending
                list.sort((a, b) => (b.correlativo || 0) - (a.correlativo || 0));
                window.actasData = list;
                
                // Update UI Views
                window.renderStats();
                window.renderTable();
            }, (error) => {
                console.error("Error en tiempo real Firebase:", error);
                window.showNotification("Error de sincronización con la nube: " + error.message, "error");
            });
        }

        // Global function to Request / Save a New Acta with Atomic Transaction
        window.solicitarNuevaActa = async function(formData) {
            if (!window.currentUser) {
                window.showNotification("Error: Sin conexión con Firebase.", "error");
                return null;
            }

            const counterDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'counters', 'sip_sequence');
            const actasColRef = collection(db, 'artifacts', appId, 'public', 'data', 'actas_penales');

            try {
                const result = await runTransaction(db, async (transaction) => {
                    const counterDoc = await transaction.get(counterDocRef);
                    let currentSeq = 0;

                    if (counterDoc.exists()) {
                        currentSeq = counterDoc.data().currentCorrelativo || 0;
                    }

                    const nextSeq = currentSeq + 1;
                    const formattedSeq = String(nextSeq).padStart(4, '0');
                    const numActa = `CZGNB13-DI-${formData.unidad}-SIP-${formattedSeq}-26`;

                    const newActaData = {
                        numActa: numActa,
                        correlativo: nextSeq,
                        unidad: formData.unidad,
                        fecha: formData.fecha,
                        funcionarios: formData.funcionarios,
                        causa: formData.causa,
                        auxiliar: formData.auxiliar,
                        observaciones: formData.observaciones || 'Sin observaciones.',
                        timestamp: new Date().toISOString(),
                        estado: 'Registrado / Asignado',
                        createdBy: window.currentUser.uid
                    };

                    const newActaDocRef = doc(actasColRef);
                    transaction.set(counterDocRef, { currentCorrelativo: nextSeq, updatedAt: new Date().toISOString() });
                    transaction.set(newActaDocRef, newActaData);

                    return newActaData;
                });

                return result;
            } catch (err) {
                console.error("Transaction Error:", err);
                throw err;
            }
        };

        // Initialize App on DOM Load
        window.addEventListener('DOMContentLoaded', () => {
            initAuthAndData();
            populateUnitSelects();
        });

        function populateUnitSelects() {
            const selectSol = document.getElementById('sol-unidad');
            const selectFilter = document.getElementById('filter-unidad');

            window.UNIDADES_TACTICAS.forEach(u => {
                if (selectSol) {
                    const opt = document.createElement('option');
                    opt.value = u;
                    opt.textContent = u;
                    selectSol.appendChild(opt);
                }
                if (selectFilter) {
                    const opt = document.createElement('option');
                    opt.value = u;
                    opt.textContent = u;
                    selectFilter.appendChild(opt);
                }
            });
        }
    </script>

